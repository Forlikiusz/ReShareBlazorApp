@page "/profil"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Mój profil – ODDAJ DALEJ</PageTitle>

<PageHeader Title="Mój profil" Subtitle="Twoje dane, ogłoszenia i opinie w jednym miejscu." />

<section class="home-section">
    <div class="home-container">

        <!-- Karta profilu -->
        <div class="profile-card">
            <span class="avatar avatar-lg">TY</span>

            <div class="profile-info">
                <h2>Twoje imię</h2>
                <AuthorizeView>
                    <Authorized Context="auth">
                        <p class="profile-email">@auth.User.FindFirst(ClaimTypes.Email)?.Value</p>
                    </Authorized>
                </AuthorizeView>
                <p class="home-card-verified">✔ E-mail zweryfikowany</p>
                <p class="profile-rating">★ 4,8 <span>(12 opinii)</span></p>
            </div>

            <a class="home-btn home-btn-outline" href="/ustawienia">Edytuj profil</a>
        </div>

        <!-- Statystyki -->
        <div class="profile-stats">
            <div class="profile-stat"><strong>5</strong><span>Ogłoszenia</span></div>
            <div class="profile-stat"><strong>2</strong><span>Poszukiwania</span></div>
            <div class="profile-stat"><strong>9</strong><span>Transakcje</span></div>
            <div class="profile-stat"><strong>14</strong><span>Ulubione</span></div>
        </div>

        <!-- Zakładki -->
        <div class="profile-tabs" role="tablist">
            <button class="profile-tab active" type="button" role="tab">Moje ogłoszenia</button>
            <button class="profile-tab" type="button" role="tab">Moje poszukiwania</button>
            <button class="profile-tab" type="button" role="tab">Ulubione</button>
            <button class="profile-tab" type="button" role="tab">Transakcje</button>
            <button class="profile-tab" type="button" role="tab">Opinie</button>
        </div>

        <!-- Moje ogłoszenia -->
        <div class="home-cards">
            <ListingCard Title="2 bilety na koncert – Kraków" Category="Bilety i rezerwacje" Type="Sprzedam"
                         Price="240 zł" Location="Kraków" Term="12.12.2026" Published="08.11.2026" Verified="true" />
            <ListingCard Title="Wózek dziecięcy do oddania" Category="Rodzina i dzieci" Type="Oddam"
                         Price="Bezpłatnie" Location="Łódź" Term="od zaraz" Published="07.11.2026" Verified="true" />
        </div>

        <!-- Opinie -->
        <h2 class="home-section-title profile-subtitle">Opinie o Tobie</h2>
        <div class="profile-reviews">
            <article class="profile-review">
                <p class="profile-rating">★★★★★ <span>Anna K.</span></p>
                <p>Szybki kontakt, wszystko zgodnie z opisem. Polecam.</p>
            </article>
            <article class="profile-review">
                <p class="profile-rating">★★★★☆ <span>Marek N.</span></p>
                <p>Sprawna wymiana, drobne opóźnienie w odpowiedzi.</p>
            </article>
        </div>
    </div>
</section>

<SiteFooter />
