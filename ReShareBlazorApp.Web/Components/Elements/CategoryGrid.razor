<section class="home-section home-section-alt">
    <div class="home-container">
        <h2 class="home-section-title">Kategorie</h2>

        <div class="home-categories">
            @foreach (var cat in categories)
            {
                <a class="home-category" href="/kategorie/@cat.Slug">
                    <strong>@cat.Name</strong>
                    <span>@cat.Description</span>
                </a>
            }
        </div>
    </div>
</section>

@code {
    private class Category
    {
        public string Name { get; set; } = "";
        public string Slug { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private List<Category> categories = new()
    {
        new Category { Name = "Bilety i rezerwacje", Slug = "bilety-i-rezerwacje", Description = "Koncerty, mecze, vouchery, bilety, spa" },
        new Category { Name = "Wyjazdy i podróże", Slug = "wyjazdy-i-podroze", Description = "Hotele, wakacje, wycieczki, noclegi" },
        new Category { Name = "Transport i miejsca", Slug = "transport-i-miejsca", Description = "Przejazdy, samochody, busy, przewóz" },
        new Category { Name = "Sprzęt i wypożyczenia", Slug = "sprzet-i-wypozyczenia", Description = "Narzędzia, elektronika, sprzęt sportowy" },
        new Category { Name = "Usługi i wolne terminy", Slug = "uslugi-i-wolne-terminy", Description = "Fachowcy, fotografia, opieka, instruktorzy" },
        new Category { Name = "Wspólne aktywności", Slug = "wspolne-aktywnosci", Description = "Sport, hobby, wyjazdy, wydarzenia" },
        new Category { Name = "Dom i przestrzeń", Slug = "dom-i-przestrzen", Description = "Garaże, parkingi, magazyny, działki" },
        new Category { Name = "Edukacja i rozwój", Slug = "edukacja-i-rozwoj", Description = "Kursy, szkolenia, warsztaty" },
        new Category { Name = "Rodzina i dzieci", Slug = "rodzina-i-dzieci", Description = "Wózki, foteliki, sprzęt, zajęcia" },
        new Category { Name = "Biznes i współpraca", Slug = "biznes-i-wspolpraca", Description = "Wolne zasoby, biura, sprzęt, partnerzy" }
    };
}
